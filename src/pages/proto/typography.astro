---
// THROWAWAY — ticket 03's prototype. Delete once the type scale is settled.
//
// Every panel renders twice, light and dark, side by side. That works with no
// JS and no toggle because the tokens use light-dark(): setting `color-scheme`
// on a wrapper is enough to flip everything inside it.
import Font from "astro/components/Font.astro";
import "@/styles/global.css";

const INTRO =
  "fullstack web/app dev. i love building seamless experiences & strongly advocate for UDD (user-driven development) over anything else.";

const INTRO_2 =
  "im into bleeding edge tech. i know not to chase the shiny thing tho. i also think low-level systems & dev tools are cool. workin' on myself to work on 'em.";

const SIZES = [
  { px: 16, lh: 1.6 },
  { px: 17, lh: 1.65 },
  { px: 18, lh: 1.7 },
  { px: 20, lh: 1.7 },
];

const THINGS = [
  ["andrew-dictate", "escape the keyboard. local speech-to-text for macOS"],
  ["better-splitwise", "scan a receipt, split the bill by item"],
  ["mojify", "turn media into text. videos in, colored ascii out"],
  ["quilt", "all your github accounts, one contribution graph"],
];

const TOYS = [
  ["onandemo.js", "oneko.js, but anything chases your cursor"],
  ["savemefrom", "paste a url, vergil slices the page to pieces"],
  ["liquid-glass-cursor", "a cursor that refracts the page"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>type — prototype</title>
    <Font cssVariable="--font-baskervville" preload />
    <Font cssVariable="--font-ioskeley" preload />
    <Font cssVariable="--font-excalifont" />
  </head>

  <body class="font-paper">
    <header class="wrap">
      <p class="label">ticket 03 · prototype</p>
      <h1 class="title">the paper, the machine, the margin</h1>
      <p class="lede">
        Every panel below is rendered twice — light on the left, dark on the
        right. Judge them against each other, not one at a time.
      </p>
    </header>

    <!-- 1. how big does Baskervville need to be -->
    <section class="wrap">
      <h2 class="h2">1 · how big does Baskervville need to be?</h2>
      <p class="note">
        It's a high-contrast revival with fine hairlines. The question is where
        it stops looking weak — especially on dark, where thin strokes thin out
        further.
      </p>

      <div class="split">
        {
          ["light", "dark"].map((scheme) => (
            <div class="panel" style={`color-scheme: ${scheme}`}>
              <p class="panel-tag">{scheme}</p>
              {SIZES.map(({ px, lh }) => (
                <div class="size-row">
                  <span class="size-tag">
                    {px}px / {lh}
                  </span>
                  <p style={`font-size:${px}px; line-height:${lh}`}>{INTRO}</p>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <!-- 2. the three roles together -->
    <section class="wrap">
      <h2 class="h2">2 · the three roles, on real copy</h2>
      <p class="note">
        Paper for prose, machine for anything factual, margin for the aside.
        This is the actual homepage content, not lorem.
      </p>

      <div class="split">
        {
          ["light", "dark"].map((scheme) => (
            <div class="panel" style={`color-scheme: ${scheme}`}>
              <p class="panel-tag">{scheme}</p>

              <h3 class="name">jass</h3>
              <p class="role">terminally online developer</p>
              <p class="body">{INTRO}</p>
              <p class="body">{INTRO_2}</p>

              <div class="job">
                <div class="job-head">
                  <span class="job-co">Cypher</span>
                  <span class="mono dim">Oct 2025 — Present</span>
                </div>
                <div class="job-head">
                  <span class="body-sm">Software Developer</span>
                  <span class="mono dim">Chennai, India</span>
                </div>
              </div>

              <p class="section-label">things</p>
              {THINGS.map(([n, d]) => (
                <p class="entry">
                  <span class="mono strong">{n}</span>
                  <span class="dash"> — </span>
                  <span class="body-sm">{d}</span>
                </p>
              ))}

              <p class="section-label">toys</p>
              {TOYS.map(([n, d]) => (
                <p class="entry">
                  <span class="mono strong">{n}</span>
                  <span class="dash"> — </span>
                  <span class="body-sm">{d}</span>
                </p>
              ))}

              <p class="margin-note">
                ...and about nine more i never wrote down
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 3. the lime problem -->
    <section class="wrap">
      <h2 class="h2">3 · lime fails in light mode</h2>
      <p class="note">
        The accent is <span class="mono">oklch(0.9392 0.1588 124.39)</span> —
        <span class="mono strong">1.16:1</span> on white,
        <span class="mono strong">17.12:1</span> on near-black. It is a dark-mode
        text colour and, in light mode, not a text colour at all. Four ways out:
      </p>

      <div class="split">
        {
          ["light", "dark"].map((scheme) => (
            <div class="panel" style={`color-scheme: ${scheme}`}>
              <p class="panel-tag">{scheme}</p>

              <p class="opt-label">a · lime as text (the naive option)</p>
              <p class="body">
                i also think{" "}
                <a class="lime-text" href="#">
                  low-level systems
                </a>{" "}
                &amp; dev tools are cool.
              </p>

              <p class="opt-label">b · lime darkened in light mode only</p>
              <p class="body">
                i also think{" "}
                <a class="lime-adaptive" href="#">
                  low-level systems
                </a>{" "}
                &amp; dev tools are cool.
              </p>

              <p class="opt-label">
                c · lime as highlight, text stays foreground
              </p>
              <p class="body">
                i also think{" "}
                <a class="lime-mark" href="#">
                  low-level systems
                </a>{" "}
                &amp; dev tools are cool.
              </p>

              <p class="opt-label">d · lime as underline only</p>
              <p class="body">
                i also think{" "}
                <a class="lime-rule" href="#">
                  low-level systems
                </a>{" "}
                &amp; dev tools are cool.
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 4. where Excalifont stops -->
    <section class="wrap">
      <h2 class="h2">4 · where does Excalifont stop?</h2>
      <p class="note">
        It carries a strong Excalidraw association. Confined to the margin
        that's charm; promoted to a headline it may read as a gimmick. Both, so
        the boundary is a decision you've seen rather than one you're told.
      </p>

      <div class="split">
        {
          ["light", "dark"].map((scheme) => (
            <div class="panel" style={`color-scheme: ${scheme}`}>
              <p class="panel-tag">{scheme}</p>

              <p class="opt-label">as the margin (proposed)</p>
              <p class="body">{INTRO}</p>
              <p class="margin-note">↑ this bit is the whole personality</p>

              <p class="opt-label">as a headline (not proposed)</p>
              <h3 class="excali-head">jass</h3>
              <p class="body-sm">terminally online developer</p>
            </div>
          ))
        }
      </div>
    </section>

    <footer class="wrap foot">
      <p class="mono dim">
        baskervville 400/700 + italic · ioskeleymono 400/700 (subset 480kb →
        34kb) · excalifont 400 — all SIL OFL 1.1, all self-hosted
      </p>
    </footer>
  </body>
</html>

<style>
  /* Prototype-only styling. Plain CSS rather than utilities: this page is one
     bespoke composition, and per ticket 09 that's what a scoped block is for. */

  body {
    margin: 0;
    padding: 0 0 6rem;
  }

  .wrap {
    margin: 0 auto;
    max-width: 78rem;
    padding: 0 1.5rem;
  }

  .label,
  .panel-tag,
  .size-tag,
  .opt-label,
  .section-label {
    font-family: var(--font-machine);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .title {
    margin: 0.5rem 0 0;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .lede {
    max-width: 46ch;
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-muted-foreground);
  }

  header.wrap {
    padding-top: 4rem;
    padding-bottom: 2rem;
  }

  .h2 {
    margin: 4rem 0 0.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .note {
    max-width: 62ch;
    margin: 0 0 1.5rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-muted-foreground);
  }

  .split {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (width >= 60rem) {
    .split {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Setting color-scheme on the panel is what flips every light-dark() token
     inside it. No class, no script. */
  .panel {
    background: var(--color-background);
    color: var(--color-foreground);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.75rem;
  }

  .panel-tag {
    margin: 0 0 1.25rem;
  }

  .size-row + .size-row {
    margin-top: 1.5rem;
  }

  .size-row p {
    margin: 0.25rem 0 0;
    max-width: 60ch;
  }

  .name {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
  }

  .role {
    margin: 0 0 1.25rem;
    font-size: 1rem;
    color: var(--color-muted-foreground);
  }

  .body {
    margin: 0 0 0.875rem;
    max-width: 60ch;
    font-size: 18px;
    line-height: 1.7;
  }

  .body-sm {
    font-size: 1rem;
    line-height: 1.6;
  }

  .mono {
    font-family: var(--font-machine);
    font-size: 0.8125rem;
  }

  .strong {
    font-weight: 700;
  }

  .dim {
    color: var(--color-muted-foreground);
  }

  .job {
    margin: 1.5rem 0;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .job-head + .job-head {
    margin-top: 0.25rem;
  }

  .job-co {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .section-label {
    margin: 1.75rem 0 0.625rem;
  }

  .entry {
    margin: 0 0 0.4375rem;
  }

  .dash {
    color: var(--color-muted-foreground);
  }

  .margin-note {
    font-family: var(--font-margin);
    font-size: 1.0625rem;
    color: var(--color-muted-foreground);
    margin: 1.25rem 0 0;
  }

  .opt-label {
    margin: 1.75rem 0 0.5rem;
  }

  .opt-label:first-of-type {
    margin-top: 0;
  }

  /* a — straight lime text. Legible on dark, near-invisible on white. */
  .lime-text {
    color: var(--color-primary);
    text-decoration: none;
  }

  /* b — same hue and chroma, lightness dropped for light mode only.
     4.63:1 on white, and reverts to the real lime on dark. */
  .lime-adaptive {
    color: light-dark(oklch(0.55 0.1588 124.39), var(--color-primary));
    text-decoration: none;
    font-weight: 700;
  }

  /* c — lime as a surface. Text keeps foreground, so contrast is never at
     risk in either theme. */
  .lime-mark {
    background: var(--color-primary);
    color: oklch(0.145 0 0);
    text-decoration: none;
    padding: 0.05em 0.3em;
    border-radius: 0.2em;
  }

  /* d — lime never touches the text, only marks it. */
  .lime-rule {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-primary);
    text-decoration-thickness: 0.18em;
    text-underline-offset: 0.18em;
  }

  .excali-head {
    font-family: var(--font-margin);
    margin: 0;
    font-size: 2.5rem;
    font-weight: 400;
  }

  .foot {
    margin-top: 4rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }
</style>
