---
import { getCollection } from "astro:content";

import { URLS } from "@/constants";
import { LAST_TOUCHED, formatStamp } from "@/last-touched";
import Layout from "@/layouts/Layout.astro";
import { WORK } from "@/data/work";

// Stage one of ticket 08: the page, plain. No micro-interactions, nothing that
// responds to the reader beyond a link. If it only comes alive once details are
// added, it was never plain-because-considered — so this state is the test.

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const things = projects.filter((p) => p.data.kind === "thing");
const toys = projects.filter((p) => p.data.kind === "toy");

// Every entry, forever — no pagination, no filtering (ticket 07). The volume is
// the argument.
const SECTIONS = [
  { id: "things", label: "things", entries: things },
  { id: "toys", label: "toys", entries: toys },
];

// The résumé is just another link here. A text-first index has no better place
// to put it, and giving it a button would make it the loudest thing on a page
// whose audience is peers, not recruiters.
const SOCIALS = [
  { label: "résumé", href: URLS.RESUME },
  { label: "twitter", href: URLS.TWITTER },
  { label: "github", href: URLS.GITHUB },
  { label: "discord", href: URLS.DISCORD },
  { label: "linkedin", href: URLS.LINKEDIN },
  { label: "email", href: URLS.EMAIL },
];

// Section headings are machine, not paper. Baskervville has no bold, so a paper
// heading can only get bigger — and bigger headings on a one-page index read as
// structure the page doesn't have. The role change does the work instead.
const HEADING = "font-machine text-micro text-muted-foreground lowercase";
---

<Layout title="jass.gg" description="terminally online developer">
  <main class="mx-auto w-full max-w-2xl px-6 py-16 sm:py-24">
    <header>
      <h1 class="font-hand text-title leading-none">jass</h1>
      <p class="mt-3 font-machine text-meta text-muted-foreground">
        terminally online developer
      </p>

      <div class="mt-8 space-y-4 text-body">
        <p>
          fullstack web/app dev. i love building seamless experiences &amp;
          strongly advocate for UDD (user-driven development) over anything
          else.
        </p>
        <p>
          im into bleeding edge tech. i know not to chase the shiny thing tho. i
          also think low-level systems &amp; dev tools are cool. workin' on
          myself to work on 'em. when im not coding, im probably getting lost in
          a good game world or the real one.
        </p>
      </div>

      <ul
        class="mt-8 flex flex-wrap gap-x-4 gap-y-2 font-machine text-meta text-muted-foreground">
        {
          SOCIALS.map((social) => (
            <li>
              <a href={social.href}>{social.label}</a>
            </li>
          ))
        }
      </ul>
    </header>

    {
      SECTIONS.map((section) => (
        <section id={section.id} class="mt-16">
          <h2 class={HEADING}>{section.label}</h2>
          <ul class="mt-4 space-y-3 text-body">
            {section.entries.map((entry) => (
              <li>
                <a href={entry.data.github} class="font-machine">
                  {entry.data.name}
                </a>
                <span class="text-muted-foreground"> — </span>
                {entry.data.description}
                {entry.data.link && (
                  <>
                    {" "}
                    <a
                      href={entry.data.link}
                      class="font-machine text-meta text-muted-foreground">
                      live
                    </a>
                  </>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {
      /* Three rows, and the shape reads without being pointed at: the same
    company opens and closes it. A bulleted CV would bury that. */
    }
    <section id="work" class="mt-16">
      <h2 class={HEADING}>work</h2>
      <ul class="mt-4 space-y-3 text-body">
        {
          WORK.map((job) => (
            <li class="flex flex-col gap-x-6 sm:flex-row sm:items-baseline sm:justify-between">
              <span>
                {job.homepage ? (
                  <a href={job.homepage}>{job.company}</a>
                ) : (
                  job.company
                )}
                <span class="text-muted-foreground">, {job.role}</span>
              </span>
              <span class="font-machine text-meta whitespace-nowrap text-muted-foreground">
                {job.period}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <footer class="mt-24 font-machine text-micro text-muted-foreground">
      last touched {formatStamp(LAST_TOUCHED)}
    </footer>
  </main>
</Layout>
