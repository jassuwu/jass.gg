---
import { getCollection } from "astro:content";

import { URLS } from "@/constants";
import { LAST_TOUCHED, formatStamp } from "@/last-touched";
import Layout from "@/layouts/Layout.astro";
import { WORK } from "@/data/work";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Every entry, forever — no pagination, no filtering (ticket 07). The volume is
// the argument.
const SECTIONS = [
  { id: "things", entries: projects.filter((p) => p.data.kind === "thing") },
  { id: "toys", entries: projects.filter((p) => p.data.kind === "toy") },
];

// One link per entry, and it goes to the built thing. The repo used to sit
// beside it as a second link; jass cut it — "let the site choose whether it
// wants to show the person to github". Two entries have no site, so those
// point at the repo and the rule still reads as "the name links to the thing".
const destination = (p: (typeof projects)[number]) =>
  p.data.link ?? p.data.github;

const SOCIALS = [
  { label: "résumé", href: URLS.RESUME },
  { label: "twitter", href: URLS.TWITTER },
  { label: "github", href: URLS.GITHUB },
  { label: "discord", href: URLS.DISCORD },
  { label: "linkedin", href: URLS.LINKEDIN },
  { label: "email", href: URLS.EMAIL },
];

// Section headings are machine and tiny. jass's favourite part of stage one,
// so nothing here touches them.
const HEADING = "font-machine text-micro text-muted-foreground";

// things, toys and writing share one shape; work is a timeline; the header and
// footer are their own. Four treatments, because jass reads the page as four
// kinds of section rather than one list repeated.
const SECTION = "mt-14";
const LIST = "mt-3 space-y-2 text-body";
---

<Layout title="jass.gg" description="software developer at cypher, chennai">
  <main class="mx-auto w-full max-w-2xl px-6 py-16 sm:py-24">
    <header>
      <h1 class="font-hand text-display">
        <span class="lime-highlight">jass</span>
      </h1>
      <p class="mt-4 font-machine text-meta text-muted-foreground">
        software developer at <a href="https://cypherhq.io">cypher</a>, chennai
      </p>

      <div class="mt-8 space-y-4 text-body">
        <p>
          fullstack web/app dev. i build for the person using it, and not much
          else.
        </p>
        <p>
          im into bleeding edge tech, but i know not to chase the shiny thing.
          low-level systems and dev tools are cool — workin' on myself to work
          on 'em. when im not coding, im probably getting lost in a good game
          world or the real one.
        </p>
      </div>

      <ul
        class="mt-8 flex flex-wrap gap-x-4 gap-y-2 font-machine text-meta text-muted-foreground">
        {
          SOCIALS.map((social) => (
            <li>
              <a href={social.href}>{social.label}</a>
            </li>
          ))
        }
      </ul>
    </header>

    {
      SECTIONS.map((section) => (
        <section id={section.id} class={SECTION}>
          <h2 class={HEADING}>{section.id}</h2>
          <ul class={LIST}>
            {section.entries.map((entry) => (
              // No separator between name and line: the colour change does
              // that work. A dash here collided with the dashes inside the
              // descriptions themselves.
              <li>
                <a href={destination(entry)}>{entry.data.name}</a>
                <span class="ml-2 text-muted-foreground">
                  {entry.data.description}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section id="writing" class={SECTION}>
      <h2 class={HEADING}>writing</h2>
      <ul class={LIST}>
        <li class="text-muted-foreground">nothing published yet.</li>
      </ul>
    </section>

    {
      /* A timeline, not a table. The periods form a left axis, so reading down
    the column is reading backwards through time — and the repeat at top and
    bottom is the whole story: he left cypher and came back. */
    }
    <section id="work" class={SECTION}>
      <h2 class={HEADING}>work</h2>
      <ul class="mt-3 space-y-2 text-body">
        {
          WORK.map((job) => (
            <li class="flex items-baseline gap-x-4 sm:gap-x-6">
              <span class="w-[8.5rem] shrink-0 font-machine text-meta text-muted-foreground">
                {job.period}
              </span>
              <span>
                {job.homepage ? (
                  <a href={job.homepage}>{job.company}</a>
                ) : (
                  job.company
                )}
                <span class="text-muted-foreground">, {job.role}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <footer class="mt-20 font-machine text-micro text-muted-foreground">
      last touched {formatStamp(LAST_TOUCHED)}
    </footer>
  </main>
</Layout>
