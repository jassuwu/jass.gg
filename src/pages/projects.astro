---
import ASSETS from "@/assets";
import { Badge, BlurBottomBlogBanner } from "@/components";
import { URLS } from "@/constants";
import { Layout } from "@/layouts";
import { resolveAssetPath } from "@/lib/images";
import { getCollection, type CollectionEntry } from "astro:content";

// Featured first, then newest ship date first
const projects = (await getCollection("projects")).sort(
  (a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) => {
    if (a.data.featured !== b.data.featured) {
      return a.data.featured ? -1 : 1;
    }
    return b.data.date.getTime() - a.data.date.getTime();
  },
);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
  })
    .format(date)
    .toLowerCase();
};
---

<Layout
  title="projects | jass.gg"
  description="things i shipped so i could stop thinking about them"
  image="/opengraph.jpg"
  imageAlt="preview of jass.gg"
  type="website">
  <main class="container-narrow h-full">
    <section class="my-8 flex flex-col justify-between gap-6 md:my-12">
      <div class="flex flex-col gap-2">
        <h1 class="font-comic-neue text-primary text-4xl font-bold md:text-5xl">
          projects
        </h1>
        <h2 class="text-lg font-bold md:text-xl">
          things i shipped so i could stop thinking about them
        </h2>
      </div>
    </section>

    <section>
      <div class="space-y-8">
        {
          projects.map((project) => {
            const thumbnail = resolveAssetPath(
              "projects",
              project.data.thumbnail,
            );
            const href = project.data.link ?? project.data.github;
            const showGithubChip = project.data.link !== undefined;
            return (
              <article class="group relative">
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block"
                  data-ph-capture-attribute-project-name={project.data.name}
                  data-ph-capture-attribute-project-url={href}>
                  <div class="relative overflow-hidden rounded-xs transition-transform duration-300 group-hover:scale-[1.02]">
                    {thumbnail ? (
                      <div class="relative h-48 md:h-56">
                        <img
                          src={thumbnail}
                          alt={project.data.thumbnailAlt || project.data.name}
                          class="absolute inset-0 h-full w-full object-cover brightness-75 contrast-125 transition-all duration-300 group-hover:brightness-50"
                          loading="lazy"
                        />

                        {/* Blur effect overlay */}
                        <div class="absolute inset-0 z-[1]">
                          <BlurBottomBlogBanner />
                        </div>

                        {/* Gradient overlay */}
                        <div class="absolute inset-0 z-[2] bg-gradient-to-t from-black/80 via-black/20 to-transparent" />

                        {/* Content overlay */}
                        <div class="absolute inset-0 z-[10] flex flex-col justify-end p-6">
                          <div class="flex flex-col gap-3">
                            <h3 class="text-xl font-bold text-white transition-colors md:text-2xl">
                              {project.data.name}
                            </h3>

                            <p class="line-clamp-2 text-sm leading-relaxed text-white/90">
                              {project.data.description}
                            </p>

                            <div class="flex items-center justify-between gap-4">
                              <time
                                class="text-sm text-white/80"
                                datetime={project.data.date.toISOString()}>
                                {formatDate(project.data.date)}
                              </time>

                              <div class="flex flex-wrap gap-2">
                                {project.data.tags
                                  .slice(0, 3)
                                  .map((tag: string) => (
                                    <Badge class="border-white/30 bg-white/20 text-white hover:bg-white/30">
                                      {tag}
                                    </Badge>
                                  ))}
                                {project.data.tags.length > 3 && (
                                  <span class="px-2 py-1 text-xs text-white/70">
                                    +{project.data.tags.length - 3}
                                  </span>
                                )}
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    ) : (
                      <div class="border-border bg-card hover:bg-accent/50 rounded-xl border p-6 transition-colors">
                        <div class="flex flex-col gap-3">
                          <h3 class="text-foreground group-hover:text-primary text-xl font-bold transition-colors md:text-2xl">
                            {project.data.name}
                          </h3>

                          <p class="text-muted-foreground text-sm leading-relaxed">
                            {project.data.description}
                          </p>

                          <div class="flex items-center justify-between gap-4">
                            <time
                              class="text-muted-foreground text-sm"
                              datetime={project.data.date.toISOString()}>
                              {formatDate(project.data.date)}
                            </time>

                            <div class="flex flex-wrap gap-2">
                              {project.data.tags.slice(0, 4).map((tag) => (
                                <Badge>{tag}</Badge>
                              ))}
                            </div>
                          </div>
                        </div>
                      </div>
                    )}
                  </div>
                </a>

                {/* github chip — sibling of the card anchor, never nested */}
                {showGithubChip && (
                  <a
                    href={project.data.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.data.name} on github`}
                    class="absolute top-4 right-4 z-20 rounded-md bg-white/20 p-2 backdrop-blur-sm transition-colors hover:bg-white/30">
                    <img {...ASSETS.ICONS.GITHUB} class="size-4" alt="github" />
                  </a>
                )}
              </article>
            );
          })
        }
      </div>
    </section>

    <section class="my-8 md:my-12">
      <div class="text-primary flex items-center gap-2">
        <img {...ASSETS.ICONS.GITHUB_PRIMARY} alt="github" />
        <p>
          checkout
          <a
            href={URLS.GITHUB}
            target="_blank"
            class="decoration-primary font-bold italic underline">github</a
          >
          for everything else. i like to keep them MIT :)
        </p>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Track projects page view + outbound card clicks
  if (typeof window !== "undefined" && window.posthog) {
    window.posthog.capture("projects_page_viewed", {
      total_projects: document.querySelectorAll("article").length,
      page_url: window.location.href,
    });

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const card = target.closest("a[data-ph-capture-attribute-project-name]");

      if (card) {
        window.posthog?.capture("project_card_clicked", {
          project_name: card.getAttribute(
            "data-ph-capture-attribute-project-name",
          ),
          project_url: card.getAttribute(
            "data-ph-capture-attribute-project-url",
          ),
          source_page: "projects_listing",
        });
      }
    });
  }
</script>
