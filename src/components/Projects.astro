---
import ASSETS from "@/assets";
import { Badge } from "@/components";
import { getCollection, type CollectionEntry } from "astro:content";

// Featured first, then newest ship date first — top 3 for the homepage
const projects = (await getCollection("projects"))
  .sort((a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) => {
    if (a.data.featured !== b.data.featured) {
      return a.data.featured ? -1 : 1;
    }
    return b.data.date.getTime() - a.data.date.getTime();
  })
  .slice(0, 3);
---

<section class="my-8 flex flex-col justify-between gap-6 md:my-12">
  <h2 class="text-lg font-bold md:text-xl">projects</h2>
  <div class="flex flex-col gap-4 md:gap-6">
    {
      projects.map((project) => (
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-2">
            {project.data.link ? (
              <a
                href={project.data.link}
                target="_blank"
                class="hover:text-primary transition-colors">
                <h3 class="text-base font-bold hover:underline md:text-lg">
                  {project.data.name}
                </h3>
              </a>
            ) : (
              <h3 class="text-base font-bold md:text-lg">
                {project.data.name}
              </h3>
            )}
            <a
              href={project.data.github}
              target="_blank"
              class="text-primary hover:text-primary/80 text-xs transition-colors hover:underline">
              <img {...ASSETS.ICONS.GITHUB} class="size-4" alt="github" />
            </a>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            {project.data.tags.map((tag) => (
              <Badge>{tag}</Badge>
            ))}
          </div>
          <p class="text-sm md:text-base">{project.data.description}</p>
        </div>
      ))
    }
  </div>
  <div class="text-primary flex items-center gap-2">
    <p>
      <a
        href="/projects"
        class="decoration-primary font-bold italic underline hover:opacity-80">
        see all projects -&gt;</a
      >
    </p>
  </div>
</section>
