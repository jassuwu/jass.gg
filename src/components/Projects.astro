---
import ASSETS from "@/assets";
import { Badge } from "@/components";
import { URLS } from "@/constants";

const PROJECTS = [
  {
    name: "mojify",
    description:
      "turn media into text. videos, images, youtube links — rendered as colored character art live in your terminal (with audio), or exported to mp4/gif/whatever. brew install jassuwu/tap/mojify.",
    tags: ["golang", "cli", "homebrew"],
    github: "https://github.com/jassuwu/mojify",
    link: "https://mojify.jass.gg",
  },
  {
    name: "incomerank",
    description:
      "how rich are u really. guess your global income rank, then ride a log-scale elevator to the truth. world bank data for 165 countries, computed fully client-side — your income never leaves the browser.",
    tags: ["astro", "typescript", "data-viz"],
    github: "https://github.com/jassuwu/incomerank",
    link: "https://incomerank.jass.gg",
  },
  {
    name: "quilt",
    description:
      "every github account you have, stitched into one green grid. merges contribution graphs client-side, and serves an embeddable svg for your readme. nothing stored, no login.",
    tags: ["astro", "typescript", "svg"],
    github: "https://github.com/jassuwu/quilt",
    link: "https://quilt.jass.gg",
  },
  {
    name: "savemefrom",
    description:
      "drop a link, and let vergil handle it. judgement cut on any webpage — chroma-keyed greenscreen video over a screenshot, all with one svg filter. no webgl needed.",
    tags: ["react", "vite", "meme"],
    github: "https://github.com/jassuwu/savemefrom",
    link: "https://savemefrom.jass.gg",
  },
  {
    name: "liquid-glass-cursor",
    description:
      "replace your cursor with a liquid glass prism that actually refracts the page behind it. zero deps, ~340 lines, all the physics in one svg displacement map. on npm.",
    tags: ["typescript", "npm", "svg-filters"],
    github: "https://github.com/jassuwu/liquid-glass-cursor",
    link: "https://liquid-glass-cursor.jass.gg",
  },
  {
    name: "subway-cursors",
    description:
      "subway surfers in your editor sidebar that plays only while the ai agent is thinking. pauses the frame your tokens stop. peak attention-span engineering.",
    tags: ["typescript", "cursor-extension", "meme"],
    github: "https://github.com/jassuwu/subway-cursors",
  },
  {
    name: "psgoogle",
    description:
      "a fast search engine for my college's website psgtech.edu. rewrote the previous slow backend to make it actually viable. overkilled it.",
    tags: ["golang", "next.js"],
    github: "https://github.com/jassuwu/psgoogle",
  },
];
---

<section class="my-8 flex flex-col justify-between gap-6 md:my-12">
  <h2 class="text-lg font-bold md:text-xl">projects</h2>
  <div class="flex flex-col gap-4 md:gap-6">
    {
      PROJECTS.map((project) => (
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-2">
            {project.link ? (
              <a
                href={project.link}
                target="_blank"
                class="hover:text-primary transition-colors">
                <h3 class="text-base font-bold hover:underline md:text-lg">
                  {project.name}
                </h3>
              </a>
            ) : (
              <h3 class="text-base font-bold md:text-lg">{project.name}</h3>
            )}
            <a
              href={project.github}
              target="_blank"
              class="text-primary hover:text-primary/80 text-xs transition-colors hover:underline">
              <img {...ASSETS.ICONS.GITHUB} class="size-4" alt="github" />
            </a>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            {project.tags.map((tag) => (
              <Badge>{tag}</Badge>
            ))}
          </div>
          <p class="text-sm md:text-base">{project.description}</p>
        </div>
      ))
    }
  </div>
  <div class="text-primary flex items-center gap-2">
    <img {...ASSETS.ICONS.GITHUB_PRIMARY} alt="github" />
    <p>
      checkout
      <a
        href={URLS.GITHUB}
        target="_blank"
        class="decoration-primary font-bold italic underline">github</a
      >
      for everything else. i like to keep them MIT :)
    </p>
  </div>
</section>
