---
import { LAST_TOUCHED, formatStamp } from "@/last-touched";

/* The stamp is a date, not a link. The commit it came from is how we found
   the date; the page only claims when content last changed. */
---

<footer class="mt-20 font-machine text-micro text-muted-foreground">
  {
    /* `<time datetime>` because the stamp is a date and the markup should
  say so, not just the pixels — the machine role, carried into the HTML
  itself. The full ISO instant rather than a bare day: the commit knows
  the moment, and truncating it to a date would re-open the timezone
  question the rendered text already glosses. Found only by whoever reads
  source, which is who it is for. */
  }
  <span>
    last touched{" "}
    <time datetime={LAST_TOUCHED.date.toISOString()}>
      {formatStamp(LAST_TOUCHED.date)}
    </time>
  </span>

  {
    /* AGENT DRAFT — jass rewrites (ticket 20). A rights fact, so it lives in
  the machine role the footer already speaks. Its own line rather than the
  stamp's: two facts sharing a line read as one claim. This room is a
  colophon, one fact per line. */
  }
  <p>© jass. all rights reserved, none exercised</p>
</footer>

<script>
  /* The 2am murmur (ticket 19). Every portfolio shows the owner's local
     time; a friend notices yours. If it is the small hours where the reader
     sits — hour 0 through 4, their clock — one line appears in the hand.
     With JS off it never exists, which is the constraint working: the
     murmur is the friend speaking, and the friend is JavaScript. No motion,
     no reveal — for the reader it is for, it was always there.

     Test seam, documented for whoever checks the work: a sessionStorage key
     `friend:pretend-hour` (0–23) overrides the clock so this can be
     verified at a civilised hour. Anything that isn't an hour falls
     through to the real one. */

  const raw = (() => {
    try {
      return sessionStorage.getItem("friend:pretend-hour");
    } catch {
      return null;
    }
  })();
  const hour =
    raw !== null && /^\d{1,2}$/.test(raw) && Number(raw) <= 23
      ? Number(raw)
      : new Date().getHours();

  if (hour <= 4) {
    const murmur = document.createElement("p");
    murmur.className = "font-hand text-micro text-accent-quiet";
    /* AGENT DRAFT — jass rewrites (ticket 20). The first draft said "me
       too, probably", which was a lie: jass's philosophy is being in bed
       on time — bryan johnson hours, bed at 9:15. So the friend isn't up
       with you; this is a note left by someone already asleep, scolding
       you from under the covers. His fragments, assembled: */
    murmur.textContent = "(go sleep girl. i've been in bed since 9:15)";
    document.querySelector("footer")?.append(murmur);
  }
</script>

{
  /* the mute egg's wiring lived here (ticket 21, cut — no one would find it); setMuted/isMuted stay on the bus as a dev seam: sessionStorage `friend:muted` */
}
