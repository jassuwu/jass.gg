---
import { LAST_TOUCHED, formatStamp } from "@/last-touched";

/* The stamp links to the commit it is claiming. A date on its own is an
   assertion; a date that hands you the diff is evidence — and it is the only
   thing on the page that is true because of how the page was built. */
---

<footer class="mt-20 font-machine text-micro text-muted-foreground">
  {
    /* `<time datetime>` because the stamp is a date and the markup should
  say so, not just the pixels — the machine role, carried into the HTML
  itself. The full ISO instant rather than a bare day: the commit knows
  the moment, and truncating it to a date would re-open the timezone
  question the rendered text already glosses. Found only by whoever reads
  source, which is who it is for. */
  }
  {
    LAST_TOUCHED.commitUrl ? (
      <a class="inline-block py-1.5" href={LAST_TOUCHED.commitUrl}>
        last touched{" "}
        <time datetime={LAST_TOUCHED.date.toISOString()}>
          {formatStamp(LAST_TOUCHED.date)}
        </time>
      </a>
    ) : (
      <span>
        last touched{" "}
        <time datetime={LAST_TOUCHED.date.toISOString()}>
          {formatStamp(LAST_TOUCHED.date)}
        </time>
      </span>
    )
  }

  {
    /* AGENT DRAFT — jass rewrites (ticket 20). A rights fact, so it lives in
  the machine role the footer already speaks. Its own line rather than the
  stamp's: the stamp is a link, and a sentence sharing a link's line reads
  as part of the claim being linked. Facts stack — this room is a colophon,
  one fact per line. */
  }
  {
    /* THE MUTE EGG (ticket 21, approved). Clicking this line mutes the site —
  "all rights reserved, none exercised" made literal the moment it is
  exercised. A <button>, not a clickable <p>, because a clickable paragraph
  exists only for whoever can see a pointer: this one is focusable, Enter and
  Space fire it, and the script below hands it aria-pressed and a label that
  says the quiet part. Preflight already strips every piece of button chrome
  — border, padding, margin, background, font, radius, all verified against
  the built CSS — so the style block covers only what the UA adds beyond
  chrome.

  No visible confirmation, in either direction. The "one exercised" rewrite
  was weighed and killed: a boilerplate line that keeps score stops reading
  as boilerplate, and the deadpan IS the joke — a visible state change is a
  confirmation, which is UI feedback, which this site's sound grammar exists
  to refuse. The honest confirmation already ships: the site goes quiet.
  With JS off the button does nothing, and a button that does nothing is
  still a fact. */
  }
  <p>
    <button class="rights" type="button">
      © jass. all rights reserved, none exercised
    </button>
  </p>
</footer>

<style>
  /* Only what preflight leaves standing. The UA centers button text, shows
     an arrow over it, and (engine-depending) refuses to let it be selected.
     This line was selectable text yesterday and stays selectable text today
     — I-beam included — because the egg's cover is that nothing changed; an
     arrow over one line of the colophon would itself be the tell. The cost,
     stated plainly: a triple-click that selects the line also toggles the
     mute. Rare, silent, and one more click undoes it. */
  .rights {
    text-align: inherit;
    cursor: text;
    -webkit-user-select: text;
    user-select: text;
  }

  /* Links get this exact ring in global.css. A button pretending to be text
     may not keep up the pretence for the keyboard — the tab stop is the one
     place the egg is marked, so it takes the site's focus mark unchanged:
     same lime, same offset. */
  .rights:focus-visible {
    outline: 2px solid var(--color-accent-mark);
    outline-offset: 3px;
  }
</style>

<script>
  /* The 2am murmur (ticket 19). Every portfolio shows the owner's local
     time; a friend notices yours. If it is the small hours where the reader
     sits — hour 0 through 4, their clock — one line appears in the hand.
     With JS off it never exists, which is the constraint working: the
     murmur is the friend speaking, and the friend is JavaScript. No motion,
     no reveal — for the reader it is for, it was always there.

     Test seam, documented for whoever checks the work: a sessionStorage key
     `friend:pretend-hour` (0–23) overrides the clock so this can be
     verified at a civilised hour. Anything that isn't an hour falls
     through to the real one. */

  const raw = (() => {
    try {
      return sessionStorage.getItem("friend:pretend-hour");
    } catch {
      return null;
    }
  })();
  const hour =
    raw !== null && /^\d{1,2}$/.test(raw) && Number(raw) <= 23
      ? Number(raw)
      : new Date().getHours();

  if (hour <= 4) {
    const murmur = document.createElement("p");
    murmur.className = "font-hand text-micro text-accent-quiet";
    /* AGENT DRAFT — jass rewrites (ticket 20). */
    murmur.textContent = "(you're up late. me too, probably)";
    document.querySelector("footer")?.append(murmur);
  }
</script>

<script>
  /* The mute egg's wiring (ticket 21). The right being exercised is the
     site's one right to make sound; setMuted holds for the visit
     (friend:muted, the bus's key) and stops anything mid-cue. Unmuting
     plays nothing — silence is the resting state, and a sound confirming
     sound-is-back-on would be a UI bleep, the exact thing the grammar
     refuses.

     The ARIA arrives from here rather than the markup on purpose: with JS
     off the button can do nothing, and a label promising "mute the site's
     sounds" on a button that can't would be the page lying to exactly the
     readers who depend on the label. The name leads with the visible text
     (WCAG 2.5.3 — voice-control users say what they see) and then says
     what it does, so a screen reader still gets the copyright fact before
     the quiet part out loud. aria-pressed is the whole state; sighted
     pointer users get nothing, which is the approved design, not an
     oversight. */
  import { isMuted, setMuted } from "@/scripts/sound";

  const rights = document.querySelector<HTMLButtonElement>("footer .rights");
  if (rights) {
    rights.setAttribute(
      "aria-label",
      "© jass. all rights reserved, none exercised — mute the site's sounds",
    );
    const reflect = () =>
      rights.setAttribute("aria-pressed", String(isMuted()));
    reflect();
    rights.addEventListener("click", () => {
      setMuted(!isMuted());
      reflect();
    });
  }
</script>
